rules_version = '2';
// Aturan database Kota Mati. Tempel seluruh isi file ini ke Firebase Console > Firestore Database > Rules, lalu Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Daftar nama yang sudah dipakai (agar nama pemain tidak kembar).
    match /names/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,10}$');
      allow update, delete: if false;
    }

    // Profil pemain: nama, EXP, statistik. Semua orang boleh membaca (untuk papan peringkat),
    // tapi hanya pemilik akun yang boleh mengubah datanya sendiri.
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nickLower.matches('^[a-z0-9_]{3,10}$')
        && request.resource.data.exp is int
        && request.resource.data.exp >= 0 && request.resource.data.exp <= 20000;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nick == resource.data.nick
        && request.resource.data.nickLower == resource.data.nickLower
        && request.resource.data.exp >= resource.data.exp
        && request.resource.data.exp - resource.data.exp <= 5000;
      allow delete: if false;
    }
  }
}
